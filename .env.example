# ===== LLM Provider Configuration =====
# Choose which provider to use: 'groq', 'litellm', or 'gemini'
# Only the active provider's credentials are required at startup.
LLM_PROVIDER=groq

# Single model name used across all providers
# Each provider interprets the model name appropriately:
#   - Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, etc.
#   - Gemini: gemini-3.1-flash-lite-preview, gemini-1.5-pro-latest, etc.
#   - LiteLLM: gpt-4o-mini or any model your proxy exposes
MODEL_NAME=llama-3.3-70b-versatile

# === Groq Configuration (when LLM_PROVIDER=groq) ===
# Get key from: https://console.groq.com
GROQ_API_KEY=

# === LiteLLM Proxy Configuration (when LLM_PROVIDER=litellm) ===
# LITELLM_BASE_URL=http://localhost:8000
# LITELLM_API_KEY=

# === Google Gemini Configuration (when LLM_PROVIDER=gemini) ===
# Get key from: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# ===== Data =====
# Required for ingest only (https://www.courtlistener.com)
COURTLISTENER_TOKEN=

# Where downloaded opinions and chunks live (default: ./data)
DATA_DIR=./data

# Limit files per ingest run (unset = all). Useful for smoke testing.
# INGEST_MAX_FILES=3

# ===== Services =====
QDRANT_URL=http://localhost:6333

# Presidio analyzer for PII detection (docker-compose maps it to 5001)
# PRESIDIO_URL=http://localhost:5001

# ===== Observability (optional — tracing disables gracefully if unset) =====
LANGFUSE_BASE_URL=http://localhost:13000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===== Server =====
# PORT=3000
# HOST=0.0.0.0

# ===== Guardrail Tuning (defaults shown) =====
# INJECTION_THRESHOLD=0.7
# GUARDRAILS_INJECTION_ENABLED=true
# GUARDRAILS_PII_ENABLED=true
# GUARDRAILS_POLICY_ENABLED=true
# POLICY_MAX_LENGTH=5000
# POLICY_MAX_NON_ASCII_PERCENT=50
